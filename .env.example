# ---------------------------------------------------------------------------
# Server Configuration
# ---------------------------------------------------------------------------
PORT=3000
HOST=localhost
NODE_ENV=development
# Optional on loopback; required for non-loopback binding (including Docker).
# Use a random value of at least 16 characters and set the same value in
# Claude Code's ANTHROPIC_AUTH_TOKEN. Never commit a real token here.
# PROXY_AUTH_TOKEN=
# Extra exact browser origins, comma-separated; never use *.
# PROXY_ALLOWED_ORIGINS=https://proxy.example.com
# Maximum JSON request body (increase for large image/context requests).
JSON_BODY_LIMIT=10mb

# ---------------------------------------------------------------------------
# GitHub Copilot Configuration
# ---------------------------------------------------------------------------
# OAuth client ID used for the GitHub device flow
GITHUB_COPILOT_CLIENT_ID=Iv1.b507a08c87ecfe98

# Copilot chat endpoint. Leave unset: the proxy uses the account-specific host
# advertised by the Copilot token (individual/business/enterprise plans differ,
# e.g. https://api.individual.githubcopilot.com). Set this only to pin a
# GitHub Enterprise host or route through a corporate proxy.
# COPILOT_CHAT_ENDPOINT=https://api.githubcopilot.com/chat/completions
# Optional native Messages endpoint override; normally derived from the account.
# COPILOT_MESSAGES_ENDPOINT=https://api.githubcopilot.com/v1/messages

# Client identity headers sent to the Copilot API. The Copilot chat endpoint
# rejects requests without a recognised integration ID.
COPILOT_INTEGRATION_ID=vscode-chat
COPILOT_EDITOR_VERSION=vscode/1.99.3
COPILOT_PLUGIN_VERSION=copilot-chat/0.26.7
COPILOT_USER_AGENT=GitHubCopilotChat/0.26.7

# ---------------------------------------------------------------------------
# Model Behaviour
# ---------------------------------------------------------------------------
# Copilot model used for unknown Claude names in compatible selection mode only.
# /v1/models is served from the live Copilot catalog, so this is only a fallback.
DEFAULT_CLAUDE_MODEL=claude-sonnet-5
# Set to true to also advertise non-Claude Copilot models (GPT, Gemini)
EXPOSE_ALL_COPILOT_MODELS=false
# Strict (default) rejects unavailable versioned IDs rather than changing models.
# Family aliases (sonnet/opus/haiku/opusplan) intentionally select a moving model.
# Set compatible to explicitly opt into the old cross-version alias fallback.
MODEL_SELECTION=strict
# Prefer native Anthropic Messages when advertised by the live model catalog.
# Native preserves thinking, signatures, cache markers and provider token counts.
# chat explicitly selects the legacy translator; native refuses unadvertised models.
# A pinned COPILOT_CHAT_ENDPOINT stays in chat mode unless native is selected.
ANTHROPIC_UPSTREAM_MODE=auto
# Chat fallback only: warn when thinking/cache/top_k/etc cannot be preserved.
# Set reject to refuse lossy chat requests. Native passes these fields through.
UNSUPPORTED_FEATURES=warn
# Chat fallback output ceiling. Native forwards the requested budget unchanged;
# its real output/context limits are validated upstream.
MAX_OUTPUT_TOKENS=64000
# Chat fallback only; native preserves the client's stream setting.
ENABLE_UPSTREAM_STREAMING=true

# ---------------------------------------------------------------------------
# Upstream Reliability
# ---------------------------------------------------------------------------
# Per-fetch deadline includes response body consumption (not just headers).
UPSTREAM_TIMEOUT_MS=300000
# No automatic replay by default: retries can consume premium requests.
# Opt in to up to 3 retries for explicit 429/502/503/504 responses only.
UPSTREAM_MAX_RETRIES=0
# Safe token/catalog GETs retry independently because they cannot start a paid
# generation and directly affect authentication and model-routing reliability.
UPSTREAM_SAFE_GET_RETRIES=2
# Maximum backoff; a longer Retry-After is returned rather than retried early.
UPSTREAM_MAX_RETRY_DELAY_MS=10000

# ---------------------------------------------------------------------------
# Rate Limiting
# ---------------------------------------------------------------------------
# Requests per minute for default endpoints (0 disables the limit)
RATE_LIMIT_DEFAULT=600
# Requests per minute for completion endpoints (0 disables the limit)
RATE_LIMIT_CHAT_COMPLETIONS=300
# Optional token ceilings. Both default to 0 (disabled) because Claude Code
# legitimately sends very large contexts.
MAX_TOKENS_PER_REQUEST=0
MAX_TOKENS_PER_MINUTE=0

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=info
